// Strictly typecheck sources, unit tests, and browser tests without emitting JavaScript.
// Exclude the Worker from this DOM environment; compile it separately.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["src/**/*.worker.ts"]
}
