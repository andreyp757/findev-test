// Назначение файла: Строгая проверка исходников, unit- и browser-тестов без выпуска JavaScript.
// Worker исключён из DOM-окружения этого конфига и собирается отдельно.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "playwright.config.ts"],
  "exclude": ["src/**/*.worker.ts"]
}
