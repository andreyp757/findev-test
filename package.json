{
  "name": "findev-test",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "wasm:build": "node scripts/build-wasm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path wasm/market-producer/Cargo.toml --locked",
    "test:all": "npm run test:rust && npm test && npm run test:wasm",
    "test:wasm": "node scripts/smoke-wasm.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.4",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@playwright/test": "1.64.1",
    "@types/node": "22.15.30",
    "jsdom": "26.1.0",
    "prettier": "3.9.10",
    "typescript": "6.0.2",
    "vitest": "5.0.5"
  },
  "type": "module",
  "overrides": {
    "@angular/build": {
      "vite": "8.3.3"
    }
  }
}
