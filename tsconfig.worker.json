// Compile the background Worker separately.
// WebWorker types exclude page-only DOM APIs from the background thread.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/worker",
    "lib": ["ES2022", "WebWorker"],
    "types": []
  },
  "include": ["src/**/*.worker.ts"]
}
